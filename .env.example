# ── AI (server-side only; never prefixed with VITE_) ─────────────────────────
# Used by the Vite dev server's /api/ai route. For production, set the same
# variable as a Supabase Edge Function secret (see README).
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5.
AI_MODEL=

# ── Supabase (optional; the app runs local-first without it) ────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
